{
  "name": "gbese",
  "version": "0.1.0",
  "private": true,
  "description": "A free, light, one-tap running game set on Nigerian streets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --project=phone-landscape && playwright test --project=perf --no-deps --workers=1",
    "check-size": "node scripts/check-size.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
